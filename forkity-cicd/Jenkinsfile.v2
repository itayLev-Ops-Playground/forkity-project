pipeline {
    agent {
        label 'ubuntu'
    }
    tools{
        nodejs 'nodejs'
    }
    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }
    environment {
        SCANNER_HOME=tool 'sonar-server'
        POSTGRES_DB       = 'forkity'
        POSTGRES_USER     = 'forkity'
        POSTGRES_PASSWORD = '7ccc9610b6a4db9b2d6506bcdc7204e1bb01fa097245292824ee09f271e68010'
        FORKITY_PORT      = '9090'
    }
    stages {
        stage('Clean workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Verify Node') {
            steps {
                // This prints the Jenkins Node Name and the system hostname
                echo "Successfully running on Jenkins Node: ${env.NODE_NAME}"
            }
        }
        stage('Checkout from Git'){
            steps{
                git branch: 'master', url: 'https://github.com/itayLev-Ops-Playground/forkity-project.git'
            }
        }
        stage('Install dependencies') {
            steps {
                dir('forkity-cicd') {
                    sh 'npm ci'
                }
            }
        }
        // stage('SonarQube Analysis') {
        //     steps {
        //         dir('forkity-cicd') {
        //             withSonarQubeEnv('sonar-server') {
        //                 // Run SonarQube scanner using npx (no global install)
        //                 sh '''
        //                 echo "🔍 Starting SonarQube Analysis..."
        //                 npx @sonar/scan \
        //                 -Dsonar.projectKey=forkity \
        //                 -Dsonar.projectName=forkity \
        //                 -Dsonar.sources=frontend/src,backend/src \
        //                 -Dsonar.language=ts \
        //                 -Dsonar.exclusions=frontend/dist/**,frontend/node_modules/**,backend/node_modules/**,backend/data/** \
        //                 -Dsonar.host.url=$SONAR_HOST_URL \
        //                 -Dsonar.login=$SONAR_AUTH_TOKEN
        //                 '''
        //             }
        //         }
        //     }
        // }
        // stage("Quality Gate") {
        //     steps {
        //         script {
        //             waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token' 
        //         }
        //     } 
        // }
        // stage('OWASP Dependency Check') {
        //     steps {
        //         dir('forkity-cicd') {
        //             echo "🔒 Running OWASP Dependency Check..."
        //             dependencyCheck additionalArguments: '--scan ./ --format XML --out .', odcInstallation: 'owasp-dp-check'
        //             dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
        //         }
        //     }
        // }
        // stage('TRIVY FS SCAN') {
        //     steps {
        //         dir('forkity-cicd') {
        //             sh "trivy fs . > trivyfs.txt"
        //         }
        //     }
        // }
        stage('Build frontend') {
            steps {
                dir('forkity-cicd') {
                    sh 'npm run build'
                }
            }
        }
        stage('Prepare Compose environment') {
            steps {
                dir('forkity-cicd') {
                    sh '''
                    if [ ! -f .env ]; then
                        printf '%s\n' \
                        "POSTGRES_DB=${POSTGRES_DB}" \
                        "POSTGRES_USER=${POSTGRES_USER}" \
                        "POSTGRES_PASSWORD=${POSTGRES_PASSWORD}" \
                        "FORKITY_PORT=${FORKITY_PORT}" > .env
                    fi
                    '''
                }
            }
        }
        stage('Validate Compose') {
            steps {
                dir('forkity-cicd') {
                    sh 'docker compose config --quiet'
                }
            }
        }
        stage('Build container images') {
            steps {
                dir('forkity-cicd') {
                    sh 'docker compose build'
                }
            }
        }
        stage("Docker Image Pushing") {
            steps{
                dir('forkity-cicd') {
                    steps {
                        withCredentials([usernamePassword(
                            credentialsId: 'dockerhub-creds',
                            usernameVariable: 'DOCKERHUB_USERNAME',
                            passwordVariable: 'DOCKERHUB_TOKEN'
                        )]) {
                            sh '''
                                set -eu
                                echo "$DOCKERHUB_TOKEN" | docker login \
                                    --username "$DOCKERHUB_USERNAME" \
                                    --password-stdin

                                docker push "itaylevops/forkity:forkity-frontend:V.0.${BUILD_NUMBER}"
                                docker push "itaylevops/forkity:forkity-backend:V.0.${BUILD_NUMBER}"
                                docker push "itaylevops/forkity:postgres:17-alpine:V.0.${BUILD_NUMBER}"
                            '''
                            }
                    // script{
                    //    withDockerRegistry(credentialsId: 'docker', toolName: 'docker'){   
                    //        sh "docker tag netflix avian19/netflix:latest "
                    //        sh "docker push avian19/netflix: "
                    //     }
                    // }
                }
            }
        }
        // stage("TRIVY Image Scan"){
        //     steps{
        //         sh "trivy image avian19/netflix:latest > trivyimage.txt" 
        //     }
        // }
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    dir('/home/user/final-proj/forkity-project/forkity-cicd/') {
                        withKubeConfig(credentialsId: 'k8s') {
                            sh 'kubectl apply -f k8s/forkity.yaml'
                            sh 'kubectl get svc'
                            sh 'kubectl get all'
                        }
                    }
                }
            }
        }
        // stage('Start application') {
        //     steps {
        //         dir('forkity-cicd') {
        //             sh 'npm run container:up'
        //         }
        //     }
        // }
    //     stage('Verify application') {
    //         steps {
    //             dir('forkity-cicd') {
    //                 sh '''
    //                 docker compose ps
    //                 node -e '
    //                 const url = `http://127.0.0.1:${process.env.FORKITY_PORT}/`;
    //                 let attempts = 0;
    //                 const check = async () => {
    //                     attempts += 1;
    //                     try {
    //                         const response = await fetch(url);
    //                         if (!response.ok) process.exit(1);
    //                     } catch (error) {
    //                         if (attempts >= 10) {
    //                             console.error(error);
    //                             process.exit(1);
    //                         }
    //                         setTimeout(check, 3000);
    //                     }
    //                 };
    //                 check();
    //                 '
    //                 '''
    //             }
    //         }
    //     }
    // }
    post {
        failure {
            dir('forkity-cicd') {
                sh 'docker compose logs --no-color --tail=100 || true'
                sh 'docker compose ps'
                sh 'docker compose logs backend --tail=200'
                sh 'docker compose logs db --tail=200'
            }
        }
        success {
            dir('forkity-cicd') {
                sh 'docker compose down --volumes --remove-orphans --rmi local'
            }
        }
        always {
            dir('forkity-cicd') {
                sh 'docker compose ps || true'
            }
            script {
                def colorCode = currentBuild.result == 'SUCCESS' ? '#2eb886' : 
                currentBuild.result == 'FAILURE' ? '#ff0000' : '#daa038'
                
                slackSend(
                    channel: '#forkity-alerts',
                    color: colorCode,
                    message: """
                    *🚀 Jenkins Build Notification*
                    *Project:* ${env.JOB_NAME}
                    *Build Number:* #${env.BUILD_NUMBER}
                    *Status:* *${currentBuild.result}*
                    *URL:* <${env.BUILD_URL}|Open Build>
    
                    ${currentBuild.result == 'SUCCESS' ? '✅ All steps completed successfully!' : 
                    currentBuild.result == 'FAILURE' ? '❌ Build failed. Please check logs.' : 
                    '⚠️ Build is unstable or aborted.'}
                    """.stripIndent()
                )
            }
        }
    }
}
