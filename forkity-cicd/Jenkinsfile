pipeline {
    agent { label 'ubuntu' }
    tools {
        nodejs 'nodejs'
    }
    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }
    environment {
        SCANNER_HOME = tool 'sonar-server'
        POSTGRES_DB = 'forkity'
        POSTGRES_USER = 'forkity'
        POSTGRES_PASSWORD = credentials('POSTGRES_PASSWORD')
        FORKITY_PORT = '9090'
    }
    stages {
        stage('Clean workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Verify Node') {
            steps {
                echo "Successfully running on Jenkins Node: ${env.NODE_NAME}"
            }
        }
        stage('Checkout from Git') {
            steps {
                git branch: 'master', url: 'https://github.com/itayLev-Ops-Playground/forkity-project.git'
            }
        }
        stage('Install dependencies') {
            steps {
                dir('forkity-cicd') {
                    sh 'npm ci'
                }
            }
        }
        stage('Build frontend') {
            steps {
                dir('forkity-cicd') {
                    sh 'npm run build'
                }
            }
        }
        stage('Prepare Compose environment') {
            steps {
                dir('forkity-cicd') {
                    sh '''
                    if [ ! -f .env ]; then
                        printf '%s\n' \
                        "POSTGRES_DB=${POSTGRES_DB}" \
                        "POSTGRES_USER=${POSTGRES_USER}" \
                        "POSTGRES_PASSWORD=${POSTGRES_PASSWORD}" \
                        "FORKITY_PORT=${FORKITY_PORT}" > .env
                    fi
                    '''
                }
            }
        }
        stage('Validate Compose') {
            steps {
                dir('forkity-cicd') {
                    sh 'docker compose config --quiet'
                }
            }
        }
        stage('Build container images') {
            steps {
                dir('forkity-cicd') {
                    sh 'docker compose build'
                }
            }
        }
        stage('Docker Image Pushing') {
            steps {
                dir('forkity-cicd') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )]) {
                        sh '''
                        set -eu
                        echo "$DOCKERHUB_TOKEN" | docker login \
                            --username "$DOCKERHUB_USERNAME" \
                            --password-stdin

                        docker tag forkity-frontend "itaylevops/forkity:frontend-V.0.${BUILD_NUMBER}"
                        docker tag forkity-backend "itaylevops/forkity:backend-V.0.${BUILD_NUMBER}"

                        docker push "itaylevops/forkity:frontend-V.0.${BUILD_NUMBER}"
                        docker push "itaylevops/forkity:backend-V.0.${BUILD_NUMBER}"
                        '''
                    }
                }
            }
        }
        stage('Deploy K8s Secret') {
            steps {
                withKubeConfig(credentialsId: 'kubeconfig') {
                    withCredentials([string(credentialsId: 'POSTGRES_PASSWORD', variable: 'PASS')]) {
                        sh '''
                            kubectl create secret generic db-secret \
                            --from-literal=POSTGRES_PASSWORD="$PASS" \
                            --dry-run=client -o yaml | kubectl apply -f -
                        '''
                    }
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    dir('forkity-cicd') {
                        withKubeConfig(credentialsId: 'kubeconfig') {
                            sh 'kubectl apply -f k8s/forkity.yaml'
                            sh 'kubectl get svc'
                            sh 'kubectl get all'
                        }
                    }
                }
            }
        }
        stage('Update Manifest Repository') {
            steps {
                script {
                    // Safe injection handling for Git URLs containing tokens/passwords
                    withCredentials([usernamePassword(
                        credentialsId: 'frokity-github', 
                        usernameVariable: 'GH_USER', 
                        passwordVariable: 'GH_TOKEN'
                    )]) {
                        
                        // Clean up any stale directory from a previous incomplete run
                        sh 'rm -rf forkity-k8s-manifests'
                        
                        // Clone using the securely injected token
                        sh "git clone https://${GH_TOKEN}@github.com/itayLev-Ops-Playground/forkity-k8s-manifests.git"

                        dir('forkity-k8s-manifests') {
                            // Update the image tags inside the files
                            sh "sed -i 's|image: .*/forkity-backend-.*|image: itaylevops/forkity:backend-V.0.${BUILD_NUMBER}|g' backend-deploy.yaml"
                            sh "sed -i 's|image: .*/forkity-frontend-.*|image: itaylevops/forkity:frontend-V.0.${BUILD_NUMBER}|g' frontend-deploy.yaml"

                            // Safe concurrent commit and push logic
                            sh '''
                                git config user.name "Jenkins CI"
                                git config user.email "jenkins@yourcompany.com"
                                git add backend-deploy.yaml frontend-deploy.yaml
                                
                                # Only commit if there are actual diff changes to prevent empty commit errors
                                if ! git diff-index --quiet HEAD --; then
                                    git commit -m "chore: upgrade frontend and backend images to build V.0.${BUILD_NUMBER} [skip ci]"
                                    
                                    # Crucial step: pull down upstream changes and rebase your commit on top
                                    git pull --rebase origin master
                                    
                                    git push origin master
                                else
                                    echo "No manifest changes detected. Skipping push."
                                fi
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        failure {
            dir('forkity-cicd') {
                sh 'docker compose logs --no-color --tail=100 || true'
                sh 'docker compose ps'
                sh 'docker compose logs backend --tail=200'
                sh 'docker compose logs db --tail=200'
            }
        }
        always {
            dir('forkity-cicd') {
                sh 'docker compose ps || true'
            }
            script {
                def slackColor = (currentBuild.result == 'SUCCESS') ? '#00FF00' : (currentBuild.result == 'FAILURE' ? '#FF0000' : '#FFFF00')

                slackSend(
                    channel: '#forkity-alerts',
                    color: slackColor,
                    message: """
                    *🚀 Jenkins Build Notification*
                    *Project:* ${env.JOB_NAME}
                    *Build Number:* #${env.BUILD_NUMBER}
                    *Status:* *${currentBuild.result ?: 'SUCCESS'}*
                    *URL:* <${env.BUILD_URL}|Open Build>
                    ${currentBuild.result == 'SUCCESS' || currentBuild.result == null ? '✅ All steps completed successfully!' : currentBuild.result == 'FAILURE' ? '❌ Build failed. Please check logs.' : '⚠️ Build is unstable or aborted.'}
                    """.stripIndent()
                )
            }
        }
    }
}
